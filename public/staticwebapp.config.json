{
  "routes": [
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    },
    {
      "route": "/data-deletion",
      "rewrite": "/data-deletion.html"
    },
    {
      "route": "/legal.css",
      "rewrite": "/legal.css"
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/img/*",
      "/css/*",
      "/js/*",
      "/imgs/*",
      "/*.svg",
      "/*.png",
      "/*.ico",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.html",
      "/*.css"
    ]
  },
  "mimeTypes": {
    ".avif": "image/avif"
  }
}
